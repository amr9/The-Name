# Copy to .env and fill in. Used by docker compose; .env is gitignored.

# — SMTP, required: the contact service exits at boot without these —
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM="The Name <no-reply@thename.me>"
# Where enquiries land. Defaults to site.email when empty.
MAIL_TO=

# — optional —
# Host port for the site.
WEB_PORT=8080
# Origins allowed to post the form, comma-separated. The site's own origin
# must be in here: a browser sends Origin on POST even same-origin. Defaults
# to http://localhost:<WEB_PORT>; set the real one in production.
ALLOWED_ORIGINS=
# Only when the site is served from a different origin than the API — point
# the form at the API's full URL (baked into the bundle at build time).
VITE_CONTACT_ENDPOINT=

# — contact service tuning (all optional; server/README.md has the full table) —
# Stored messages allowed per IP / per address in a 15-minute window.
RATE_PER_IP=5
RATE_PER_EMAIL=3
# Requests per IP in that window, accepted or not — the abuse ceiling.
RATE_ATTEMPTS_PER_IP=20
# Spam score at which a submission is held for review instead of emailed.
SPAM_THRESHOLD=5
# How long submissions are kept. They hold personal data and an IP address,
# so this is a liability as much as a record — shorten it if you can.
RETENTION_DAYS=365
